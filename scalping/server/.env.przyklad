# Skopiuj jako scalping/server/.env i uzupełnij. Plik .env nie trafia do repozytorium.
# Klucz API: Capital.com -> Ustawienia -> API integrations -> Generate new key (wymaga włączonego 2FA).
CAPITAL_API_KEY=
# Login (e-mail) do Capital.com
CAPITAL_IDENTIFIER=
# Hasło ustawione przy tworzeniu klucza API
CAPITAL_PASSWORD=
# 1 = konto demo, 0 = konto rzeczywiste (klucz musi być wygenerowany dla tego samego typu konta)
CAPITAL_DEMO=1
# Kod instrumentu (epic); sprawdź: node scalping/server/capital-proxy.js --szukaj "US Tech"
CAPITAL_EPIC=US100
PORT=8787
# 1 = aplikacja dostępna też z telefonu w tej samej sieci Wi-Fi (lub przez Tailscale); 0 = tylko ten komputer
DOSTEP_Z_SIECI=0
